# Copy to .env and replace every change-me value. .env is gitignored; never commit it.
# PostgreSQL Database Configuration
POSTGRES_USER=upskill
POSTGRES_PASSWORD=change-me
POSTGRES_DB=upskill_ai

# Backend API Configuration
DATABASE_URL=postgresql://upskill:change-me@upskill-db:5432/upskill_ai
JWT_SECRET=change-me-to-a-long-random-string
PORT=8000

# Frontend Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
